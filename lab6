# ===== IMPORT =====
import cv2, os, random
import numpy as np
import matplotlib.pyplot as plt

# ===== HÀM LOAD =====
def load(folder, f):
    img = cv2.imread(os.path.join(folder, f))
    if img is None:
        return None
    return cv2.resize(img,(224,224))


# =====================================================
#  BÀI 1: CĂN HỘ
# =====================================================
print("\n===== BÀI 1 =====")

folder1 = "images/canho"

files1 = [f for f in os.listdir(folder1) if f.endswith(('.jpg','.png','.jpeg','.webp'))]

plt.figure(figsize=(10,5))

for i,f in enumerate(random.sample(files1, min(5,len(files1)))):
    img = load(folder1, f)
    if img is None:
        continue

    original = img.copy()

    if random.random()>0.5:
        img = cv2.flip(img,1)

    M = cv2.getRotationMatrix2D((112,112),random.uniform(-15,15),1)
    img = cv2.warpAffine(img,M,(224,224))

    img = np.clip(img*random.uniform(0.8,1.2),0,255).astype(np.uint8)

    gray = cv2.cvtColor(img,cv2.COLOR_BGR2GRAY)/255.0

    plt.subplot(2,5,i+1)
    plt.imshow(cv2.cvtColor(original,cv2.COLOR_BGR2RGB))
    plt.axis("off")

    plt.subplot(2,5,i+6)
    plt.imshow(gray,cmap='gray')
    plt.axis("off")

plt.show()


# =====================================================
# BÀI 2: XE
# =====================================================
print("\n===== BÀI 2 =====")

folder2 = "images/xe"
files2 = [f for f in os.listdir(folder2) if f.endswith(('.jpg','.png','.jpeg','.webp'))]

img = load(folder2, random.choice(files2))

if img is not None:
    noise = np.random.normal(0,10,img.shape).astype(np.uint8)
    img2 = np.clip(img + noise,0,255)

    img2 = np.clip(img2*random.uniform(0.85,1.15),0,255).astype(np.uint8)

    M = cv2.getRotationMatrix2D((112,112),random.uniform(-10,10),1)
    img2 = cv2.warpAffine(img2,M,(224,224))

    gray = cv2.cvtColor(img2,cv2.COLOR_BGR2GRAY)/255.0

    plt.subplot(1,2,1)
    plt.imshow(cv2.cvtColor(img,cv2.COLOR_BGR2RGB))
    plt.axis("off")

    plt.subplot(1,2,2)
    plt.imshow(gray,cmap='gray')
    plt.axis("off")

    plt.show()


# =====================================================
#BÀI 3: HOA QUẢ
# =====================================================
print("\n===== BÀI 3 =====")

folder3 = "images/hoaqua"
files3 = [f for f in os.listdir(folder3) if f.endswith(('.jpg','.png','.jpeg','.webp'))]

img = load(folder3, random.choice(files3))

def aug(x):
    if random.random()>0.5:
        x = cv2.flip(x,1)

    s = random.randint(150,224)
    a = random.randint(0,224-s)
    b = random.randint(0,224-s)
    x = cv2.resize(x[b:b+s,a:a+s],(224,224))

    M = cv2.getRotationMatrix2D((112,112),0,random.uniform(1,1.3))
    x = cv2.warpAffine(x,M,(224,224))

    M = cv2.getRotationMatrix2D((112,112),random.uniform(-20,20),1)
    x = cv2.warpAffine(x,M,(224,224))

    return cv2.cvtColor(x,cv2.COLOR_BGR2RGB)/255.0

if img is not None:
    plt.figure(figsize=(6,6))
    for i in range(9):
        plt.subplot(3,3,i+1)
        plt.imshow(aug(img.copy()))
        plt.axis("off")
    plt.show()


