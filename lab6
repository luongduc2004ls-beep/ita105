# BÀI 4: NỘI THẤT
# =====================================================
print("\n===== BÀI 4 =====")

folder4 = "images/noithat"
files4 = [f for f in os.listdir(folder4) if f.endswith(('.jpg','.png','.jpeg','.webp'))]

img = load(folder4, random.choice(files4))

def aug4(x):
    if random.random()>0.5:
        x = cv2.flip(x,1)

    M = cv2.getRotationMatrix2D((112,112),random.uniform(-15,15),1)
    x = cv2.warpAffine(x,M,(224,224))

    x = np.clip(x*random.uniform(0.8,1.2),0,255).astype(np.uint8)

    return cv2.cvtColor(x,cv2.COLOR_BGR2GRAY)/255.0

if img is not None:
    plt.figure(figsize=(8,4))

    plt.subplot(1,4,1)
    plt.imshow(cv2.cvtColor(img,cv2.COLOR_BGR2RGB))
    plt.axis("off")

    for i in range(3):
        plt.subplot(1,4,i+2)
        plt.imshow(aug4(img.copy()),cmap='gray')
        plt.axis("off")

    plt.show()
