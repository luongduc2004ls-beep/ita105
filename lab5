import pandas as pd
import matplotlib.pyplot as plt
from statsmodels.tsa.seasonal import seasonal_decompose

plt.rcParams["figure.figsize"] = (10,5)


# =========================================================
#  BÀI 1: SUPERMARKET
# =========================================================
print("\n===== BÀI 1 =====")

df1 = pd.read_csv("ITA105_Lab_5_Supermarket.csv")

df1["date"] = pd.to_datetime(df1["date"])
df1 = df1.set_index("date")

print(df1.isnull().sum())
df1 = df1.fillna(method="ffill")

# feature
df1["year"] = df1.index.year
df1["month"] = df1.index.month
df1["quarter"] = df1.index.quarter
df1["dayofweek"] = df1.index.dayofweek
df1["weekend"] = df1["dayofweek"] >= 5

# tháng
df1["revenue"].resample("M").sum().plot(title="Doanh thu tháng")
plt.show()

# tuần
df1["revenue"].resample("W").sum().plot(title="Doanh thu tuần")
plt.show()

# trend
df1["revenue"].rolling(30).mean().plot(title="Trend 30 ngày")
plt.show()

# decomposition
seasonal_decompose(df1["revenue"], model="additive", period=30).plot()
plt.show()


# =========================================================
#  BÀI 2: WEB TRAFFIC
# =========================================================
print("\n===== BÀI 2 =====")

df2 = pd.read_csv("ITA105_Lab_5_Web_traffic.csv")

df2["datetime"] = pd.to_datetime(df2["datetime"])
df2 = df2.set_index("datetime")

# resample đúng
df2 = df2.resample("H").mean()

# interpolate
df2["visits"] = df2["visits"].interpolate()

# tạo feature
df2["hour"] = df2.index.hour
df2["dayofweek"] = df2.index.dayofweek

print(df2.head())

# theo giờ
df2.groupby("hour")["visits"].mean().plot(title="Traffic theo giờ")
plt.show()

# seasonality ngày
df2["visits"].resample("D").mean().plot(title="Theo ngày")
plt.show()

# seasonality tuần
df2["visits"].resample("W").mean().plot(title="Theo tuần")
plt.show()


# =========================================================
#  BÀI 3: STOCK
# =========================================================
print("\n===== BÀI 3 =====")

df3 = pd.read_csv("ITA105_Lab_5_Stock.csv")

df3["date"] = pd.to_datetime(df3["date"])
df3 = df3.set_index("date")

df3 = df3.fillna(method="ffill")

# giá
df3["close_price"].plot(title="Giá đóng cửa")
plt.show()

# moving average
df3["MA7"] = df3["close_price"].rolling(7).mean()
df3["MA30"] = df3["close_price"].rolling(30).mean()

df3[["close_price","MA7","MA30"]].plot(title="Trend")
plt.show()

# seasonality
df3["month"] = df3.index.month
df3.groupby("month")["close_price"].mean().plot(title="Seasonality tháng")
plt.show()


# =========================================================
#  BÀI 4: PRODUCTION
# =========================================================
print("\n===== BÀI 4 =====")

df4 = pd.read_csv("ITA105_Lab_5_Production.csv")

df4["week_start"] = pd.to_datetime(df4["week_start"])
df4 = df4.set_index("week_start")

df4 = df4.fillna(method="ffill")

# feature
df4["year"] = df4.index.year
df4["quarter"] = df4.index.quarter
df4["week"] = df4.index.isocalendar().week

# trend
df4["production"].rolling(10).mean().plot(title="Trend")
plt.show()

# seasonality
df4.groupby("quarter")["production"].mean().plot(title="Seasonality quý")
plt.show()

# decomposition
seasonal_decompose(df4["production"], model="additive", period=12).plot()
plt.show()
